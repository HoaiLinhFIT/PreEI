<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Version>1.0.0</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- The WinForms engine and splitter are linked unchanged: no duplicated algorithm. -->
    <Compile Include="../PreEI/Mining/*.cs" Link="Mining/%(Filename)%(Extension)" />
    <Compile Include="../PreEI/DataSplitter.cs" Link="DataSplitter.cs" />
  </ItemGroup>
</Project>
